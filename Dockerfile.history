# Optional CPU-only local embedding runtime. Build the core image first:
# docker build -t whatsapp-mcp:history-core .
# docker build -f Dockerfile.history -t whatsapp-mcp:history-local .
ARG CORE_IMAGE=whatsapp-mcp:history-core
FROM ${CORE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/history
COPY scripts/history/requirements.txt /tmp/history-requirements.txt
# Use CPU wheels explicitly. Never pull CUDA packages or a substitute model.
RUN /opt/history/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.15.0 torchvision==0.29.1 \
    && /opt/history/bin/pip install --no-cache-dir -r /tmp/history-requirements.txt \
    && /opt/history/bin/python -c 'import sentence_transformers, transformers, torch, PIL, torchvision; assert sentence_transformers.__version__ == "6.2.0"; assert transformers.__version__ == "5.21.0"; assert torch.__version__.split("+")[0] == "2.15.0"; assert PIL.__version__ == "12.3.0"; assert torchvision.__version__.split("+")[0] == "0.29.1"' \
    && rm /tmp/history-requirements.txt
ENV HISTORY_PYTHON=/opt/history/bin/python
USER 10001:10001
