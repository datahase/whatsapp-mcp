# Build context allowlist: only what the image build needs.
*
!go.mod
!go.sum
!cmd/
!internal/
!web/
!assets/
assets/**
!assets/brand/
!assets/brand/whatsapp-mcp-icon.png
!assets/brand/whatsapp-mcp-logo-transparent.png
!LICENSE
!NOTICE
!LICENSE-UPSTREAM-MIT
!THIRD_PARTY_NOTICES.md
!THIRD_PARTY_LICENSES.txt
!UPSTREAM.md
# Never ship tests data that is not needed at runtime, or anything private.
**/*_test.go
**/testdata/
work/
secrets/
data/
.env*
*.db
*.db-*

web/node_modules/
web/.next/
web/out/
web/public/brand/
web/*.tsbuildinfo
internal/httpapi/static/
