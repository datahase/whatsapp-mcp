# Copy to .env (git-ignored) or run ./scripts/init-env.sh, which also fills in
# random secrets. Keep .env private: it holds credentials. Restart the
# container after editing: docker compose up -d

# --- Required -------------------------------------------------------------
# Bearer token for MCP and media requests (at least 16 characters).
WHATSAPP_MCP_TOKEN=
# Admin/pairing page password; must differ from the token.
WHATSAPP_MCP_ADMIN_PASSWORD=

# Accounts as id:Label pairs, comma-separated. The id names the data
# directory and must not change after pairing.
WHATSAPP_MCP_ACCOUNTS=personal:Personal,second:Second number

# --- Network --------------------------------------------------------------
# Host interface to publish on. 127.0.0.1 = this machine only. Set a LAN, VPN
# or Tailscale address to reach it from other devices, and list the same
# address in WHATSAPP_MCP_ALLOWED_HOSTS.
BIND_IP=127.0.0.1
HOST_PORT=8765
WHATSAPP_MCP_ALLOWED_HOSTS=

# --- Optional AI: transcription, translation, image analysis --------------
# WhatsApp reading and sending work with this off.
AI_ENABLED=false

# Translation and image analysis provider:
#   gemini (default) | openai | groq | openrouter | anthropic | openai_compatible
AI_PROVIDER=gemini
# Transcription provider (default: same as AI_PROVIDER; required with anthropic):
#   gemini | openai | groq | openrouter | openai_compatible
#   or a dedicated speech-to-text service: deepgram | elevenlabs | assemblyai
AI_TRANSCRIBE_PROVIDER=

# API keys: set the ones for the providers you use. Use paid keys for
# personal media; there is no fallback to free tiers.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# Model IDs. Leave empty for the provider default where one exists; change
# them here and restart. MCP clients cannot pick models.
#   gemini:     gemini-3.5-transcribe / gemini-3.5-flash-lite / gemini-3.8-flash
#   openai:     gpt-4o-transcribe     / (set AI_MODEL)
#   groq:       whisper-large-v3      / (set AI_MODEL)
#   openrouter: (set both, e.g. google/gemini-3.5-flash)
#   anthropic:  -                     / claude-opus-5-5 (claude-haiku-5-5 is cheaper)
#   deepgram nova-3, elevenlabs scribe_v2, assemblyai universal-3-5-pro
AI_TRANSCRIBE_MODEL=
AI_MODEL=
AI_QUALITY_MODEL=

# Advanced (usually leave empty):
#   AI_BASE_URL / AI_TRANSCRIBE_BASE_URL   override endpoints (required for openai_compatible)
#   AI_API_KEY                             key for openai_compatible
#   AI_TRANSCRIBE_METHOD                   chat | audio_transcriptions (OpenAI-shaped providers)
#   AI_AUDIO_FORMAT                        wav | original
AI_BASE_URL=
AI_TRANSCRIBE_BASE_URL=
AI_API_KEY=

# Translation default and daily app allowances (UTC day).
AI_TARGET_LANGUAGE=en
AI_DAILY_REQUESTS=50
AI_DAILY_AUDIO_MINUTES=30

# --- Image -----------------------------------------------------------------
# WHATSAPP_MCP_IMAGE=datahase/whatsapp-mcp:0.2.0
